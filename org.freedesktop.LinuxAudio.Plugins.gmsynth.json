{
    "id": "org.freedesktop.LinuxAudio.Plugins.gmsynth",
    "branch": "26.08",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//26.08",
    "build-extension": true,
    "build-options": {
        "prepend-pkg-config-path": "/app/extensions/Plugins/gmsynth/lib/pkgconfig",
        "prepend-ld-library-path": "/app/extensions/Plugins/gmsynth/lib",
        "prefix": "/app/extensions/Plugins/gmsynth"
    },
    "cleanup": [
        "/lib/lib*",
        "/lib/lv2",
        "/share/doc",
        "/share/man"
    ],
    "modules": [
        "shared-modules/linux-audio/lv2.json",
        {
            "name": "gmsynth",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "PREFIX": "${FLATPAK_DEST}"
                }
            },
            "build-commands": [
                "make -j${FLATPAK_BUILDER_N_JOBS}",
                "make -j${FLATPAK_BUILDER_N_JOBS} install LV2DIR=${FLATPAK_DEST}/lv2"
            ],
            "post-install": [
                "install -Dm644 org.freedesktop.LinuxAudio.Plugins.gmsynth.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/x42/gmsynth.lv2/archive/v0.6.4.tar.gz",
                    "sha256": "71e9877a41be595c3850a6af305893ad76f440dda7826bab138c3bc97ed0581e"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.gmsynth.metainfo.xml"
                }
            ]
        }
    ]
}
